# =============================================================================
# BG Command Centre - Environment Configuration
# Copy this file to `.env` and adjust the values for your environment.
# Every value below is read by the application at startup. Nothing here is a
# real secret; all values are placeholders you must replace.
# =============================================================================

# Flask environment / which config class to load:
#   development | testing | production
FLASK_CONFIG=development

# Session signing key. Generate a strong random value in production, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# SQLAlchemy database URI. Defaults to a local SQLite file if left blank.
# Postgres is supported later via the same config key, e.g.
#   postgresql+psycopg2://user:pass@host/db
DATABASE_URL=sqlite:///bgcc_dev.db

# Celery broker + result backend. In production use Redis:
#   redis://localhost:6379/0
# Leave empty for local development (eager / in-memory mode is used).
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Production-only rate limiting toggle (disabled in development/testing).
RATE_LIMIT_ENABLED=false

# Session cookie "secure" flag (must be true in production over HTTPS).
SESSION_COOKIE_SECURE=false

# Idle session timeout in hours for a workplace tool.
SESSION_IDLE_HOURS=8

# Maximum uploaded file size, in megabytes.
MAX_UPLOAD_MB=25

# ---- Account lockout (per-email) ----
LOGIN_ATTEMPT_LIMIT=5
LOGIN_LOCKOUT_MINUTES=15

# ---- SMTP transactional email ----
# If SMTP_HOST is empty, email content is logged to the console instead of
# being sent, so the app still runs end-to-end in a sandbox without live mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@bgcc.local
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# ---- Company / product identity ----
COMPANY_NAME=BG Command Centre
COMPANY_EMAIL_DOMAIN=bg.center
PWA_NAME=BG Command Centre
PWA_SHORT_NAME=BGCC

# ---- Admin creation ----
# When set, `flask create-admin` uses these credentials for the admin account
# instead of generating a random password.
ADMIN_EMAIL=admin@bg.center
ADMIN_PASSWORD=
ADMIN_NAME=Platform Administrator

# Default SAP system code.
DEFAULT_SAP_SYSTEM=GRP001

# ---- Gemini AI (Step 2) ----
# Official Google GenAI API key. If left blank the AI validation pipeline will
# surface a manual-retry state rather than run (it cannot call Gemini without a
# key). Model is read from here so it can be changed without a code deploy.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- SAP financial integration (Step 2) ----
# When SAP_PO_ENDPOINT is set, PO/SAP financial context is fetched from this
# real endpoint (OAuth via SAP_CLIENT_ID / SAP_CLIENT_SECRET against
# SAP_BASE_URL). When left blank the code uses the local `sap_po_records`
# dataset, so the cross-check is fully exercisable without a live SAP system.
SAP_PO_ENDPOINT=
SAP_CLIENT_ID=
SAP_CLIENT_SECRET=
SAP_BASE_URL=

# ---- Upload ceilings (MB) ----
NEW_BG_MAX_MB=20
EXTENDED_BG_MAX_MB=10

# ---- Web push (VAPID) ----
# Browser push notifications. Generate a key pair with:
#   python -c "from pywebpush import generate_vapid_keys; import json; print(json.dumps(generate_vapid_keys()))"
# Leave blank to disable real push delivery (the channel logs instead).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=admin@bg.center
